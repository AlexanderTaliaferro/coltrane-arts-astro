---
const links = [
  { href: "/#mission", label: "Mission" },
  { href: "/#events", label: "Events" },
  { href: "/#gallery", label: "Gallery" },
  { href: "/#board", label: "Board" },
  { href: "/#donate", label: "Donate" },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500"
  data-nav
>
  <div class="flex items-center justify-between px-6 py-5 md:px-12">
    <a href="/" class="block">
      <span class="block text-[0.65rem] tracking-[0.3em] uppercase text-muted">St. John</span>
      <span class="font-display text-xl tracking-wide text-ink">Coltrane Arts</span>
    </a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-8">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="text-[0.7rem] tracking-[0.25em] uppercase text-ink/80 hover:text-gold transition-colors duration-300"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="md:hidden text-ink/80"
      aria-label="Menu"
      data-nav-toggle
    >
      <svg width="22" height="14" viewBox="0 0 22 14" fill="none">
        <line x1="0" y1="1" x2="22" y2="1" stroke="currentColor" />
        <line x1="0" y1="13" x2="22" y2="13" stroke="currentColor" />
      </svg>
    </button>
  </div>

  <div
    class="md:hidden hidden border-t border-ink/10 bg-canvas/95 backdrop-blur"
    data-nav-mobile
  >
    <ul class="flex flex-col px-6 py-4 gap-3">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="block text-sm tracking-[0.2em] uppercase text-ink/80 py-2"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const mobile = document.querySelector<HTMLElement>("[data-nav-mobile]");

  // Solid background after scroll
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 40) {
      nav.classList.add("bg-canvas/85", "backdrop-blur", "border-b", "border-ink/5");
    } else {
      nav.classList.remove("bg-canvas/85", "backdrop-blur", "border-b", "border-ink/5");
    }
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Mobile menu toggle
  toggle?.addEventListener("click", () => {
    mobile?.classList.toggle("hidden");
  });

  // Close mobile menu after click
  mobile?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => mobile.classList.add("hidden"));
  });
</script>
