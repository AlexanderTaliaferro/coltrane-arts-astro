---
// Hero: full-bleed cinematic open. Emory Douglas portrait drifts up from black.
---

<section
  id="top"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <!-- Background portrait -->
  <div class="absolute inset-0 z-0" data-hero-bg>
    <div
      class="absolute inset-0 bg-no-repeat bg-center bg-cover opacity-0 transition-opacity duration-[2200ms] ease-out"
      data-hero-image
      style="background-image: url('/images/coltrane-portrait.jpg'); background-position: center 20%;"
    ></div>
    <!-- Vignette + gradient overlays -->
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(ellipse at center, rgba(10,10,10,0.2) 0%, rgba(10,10,10,0.85) 70%, rgba(10,10,10,1) 100%);"
    ></div>
    <div
      class="absolute inset-x-0 bottom-0 h-1/3"
      style="background: linear-gradient(to bottom, transparent, #0a0a0a);"
    ></div>
  </div>

  <!-- Foreground content -->
  <div class="relative z-10 text-center px-6 max-w-4xl">
    <p class="eyebrow reveal" style="--reveal-delay: 200ms;">
      Saint John Coltrane Arts
    </p>

    <h1
      class="reveal mt-8 font-display text-[clamp(3rem,9vw,7.5rem)] leading-[0.95] tracking-tight text-ink"
      style="--reveal-delay: 400ms;"
    >
      A Love<br />
      <em class="italic text-gold/90">Supreme</em>
    </h1>

    <div class="reveal mt-10 flex justify-center" style="--reveal-delay: 700ms;">
      <span class="rule"></span>
    </div>

    <p
      class="reveal mt-10 max-w-xl mx-auto text-ink/75 text-[1.05rem] leading-relaxed font-light"
      style="--reveal-delay: 900ms;"
    >
      Youth music education and cultural enrichment in San Francisco, guided by
      the spiritual and artistic legacy of John Coltrane.
    </p>

    <div class="reveal mt-12 flex flex-wrap items-center justify-center gap-4" style="--reveal-delay: 1100ms;">
      <a href="#mission" class="btn">
        Our Mission
        <span class="arrow">↓</span>
      </a>
      <a href="#donate" class="btn" style="border-color: rgba(245,241,232,0.25);">
        Support
      </a>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10">
    <div class="flex flex-col items-center gap-3 opacity-60">
      <span class="text-[0.6rem] tracking-[0.4em] uppercase text-ink/60">Scroll</span>
      <span class="block w-px h-10 bg-ink/40 animate-pulse"></span>
    </div>
  </div>
</section>

<script>
  // Fade in the portrait once page is settled
  requestAnimationFrame(() => {
    const img = document.querySelector<HTMLElement>("[data-hero-image]");
    if (img) {
      requestAnimationFrame(() => {
        img.style.opacity = "0.55";
      });
    }
  });

  // Subtle parallax on hero background
  const bg = document.querySelector<HTMLElement>("[data-hero-bg]");
  if (bg) {
    window.addEventListener(
      "scroll",
      () => {
        const y = window.scrollY;
        if (y < window.innerHeight) {
          bg.style.transform = `translateY(${y * 0.3}px)`;
        }
      },
      { passive: true }
    );
  }
</script>
