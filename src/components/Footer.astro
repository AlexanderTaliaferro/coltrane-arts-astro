---
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 px-6 md:px-12 py-16">
  <div class="mx-auto max-w-6xl grid grid-cols-1 md:grid-cols-12 gap-10">
    <div class="md:col-span-5">
      <span class="block text-[0.65rem] tracking-[0.3em] uppercase text-muted">St. John</span>
      <span class="font-display text-2xl tracking-wide text-ink">Coltrane Arts</span>
      <p class="mt-6 text-sm text-ink/65 leading-relaxed max-w-sm">
        A 501(c)(3) charitable organization providing music education and cultural
        enrichment to underserved youth in San Francisco.
      </p>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow text-muted">Visit</p>
      <ul class="mt-4 space-y-2 text-sm text-ink/75">
        <li>Saint John Coltrane Church</li>
        <li>San Francisco, California</li>
        <li>
          <a
            href="https://www.coltranechurch.org/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink/75 hover:text-gold transition-colors duration-300 underline-offset-4 hover:underline"
          >
            coltranechurch.org →
          </a>
        </li>
      </ul>
    </div>

    <div class="md:col-span-4">
      <p class="eyebrow text-muted">Explore</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="#mission" class="text-ink/75 hover:text-gold transition-colors">Mission</a></li>
        <li><a href="#events" class="text-ink/75 hover:text-gold transition-colors">Events</a></li>
        <li><a href="#gallery" class="text-ink/75 hover:text-gold transition-colors">Gallery</a></li>
        <li><a href="#board" class="text-ink/75 hover:text-gold transition-colors">Board of Directors</a></li>
        <li><a href="#donate" class="text-ink/75 hover:text-gold transition-colors">Donate</a></li>
      </ul>
    </div>
  </div>

  <div class="mx-auto max-w-6xl mt-16 pt-8 border-t border-ink/5 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-muted tracking-wider">
    <p>© {year} Saint John Coltrane Arts. All rights reserved.</p>
    <p>"A Love Supreme."</p>
  </div>
</footer>
