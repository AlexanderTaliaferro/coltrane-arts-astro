---
// Board of Directors: pre-populated with Church leadership as starter entries.
// Bios are placeholders to be confirmed/edited.

const members = [
  {
    name: "Archbishop Franzo Wayne King",
    title: "Founder & Chair",
    bio: "Co-founder of the Saint John Will-I-Am Coltrane African Orthodox Church. A lifelong advocate for the spiritual and cultural power of John Coltrane's music as a vehicle for community uplift in San Francisco.",
    image: "/images/board-franzo.jpg",
  },
  {
    name: "Reverend Mother Marina King",
    title: "Co-Founder & Vice Chair",
    bio: "Co-founder of the Coltrane Church and a steward of the congregation for more than four decades. Vocalist, minister, and a guiding force for the Foundation's youth education mission.",
    image: "/images/board-marina.jpg",
  },
];
---

<section id="board" class="section">
  <div class="mx-auto max-w-6xl">
    <div class="reveal">
      <p class="eyebrow">Board of Directors</p>
      <span class="rule mt-6"></span>
    </div>

    <h2 class="reveal mt-10 font-display text-[clamp(2.25rem,5vw,4rem)] leading-[1.05] text-ink max-w-3xl">
      Stewards of a living legacy.
    </h2>

    <div class="mt-20 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 max-w-3xl">
      {members.map((m, i) => (
        <article class="reveal" style={`--reveal-delay: ${i * 120}ms;`}>
          <div class="aspect-[3/4] bg-canvas border border-ink/10 overflow-hidden">
            <img
              src={m.image}
              alt={m.name}
              class="archival w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="mt-6">
            <p class="eyebrow text-gold">{m.title}</p>
            <h3 class="mt-3 font-display text-2xl text-ink leading-tight">{m.name}</h3>
            <p class="mt-4 text-ink/70 text-sm leading-relaxed">{m.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
