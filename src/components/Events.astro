---
// Events: the featured event, sourced from the shared events data.
// When nothing is featured, the section shows an invitation to check back.
import { featuredEvent } from "../data/events";
const event = featuredEvent;

// Derive the "Save the Date" month/day display from the event's ISO date.
const eventDate = event ? new Date(`${event.dateISO}T00:00:00`) : null;
const eventMonth = eventDate?.toLocaleDateString("en-US", { month: "short" });
const eventDay = eventDate?.toLocaleDateString("en-US", { day: "2-digit" });
---

<section id="events" class="section bg-canvas">
  <div class="mx-auto max-w-6xl">
    <div class="reveal">
      <p class="eyebrow">Events</p>
      <span class="rule mt-6"></span>
    </div>

    <h2 class="reveal mt-10 font-display text-[clamp(2.25rem,5vw,4rem)] leading-[1.05] text-ink">
      {event ? "Come catch the vibration." : "Come back soon for upcoming events."}
    </h2>

    {!event && (
      <p class="reveal mt-8 text-ink/70 max-w-xl text-[1.05rem] leading-relaxed">
        We're planning what's next. In the meantime, revisit the music we've
        already made together.
      </p>
    )}

    {event && (
    <article class="reveal mt-20 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <!-- Date column -->
      <div class="lg:col-span-3">
        <div class="border-t border-gold/50 pt-6">
          <p class="eyebrow text-gold">Save the Date</p>
          <p class="mt-6 font-display text-5xl text-ink leading-none">{eventMonth}</p>
          <p class="font-display text-7xl text-ink leading-none">{eventDay}</p>
          <p class="mt-4 text-ink/70 text-sm tracking-wider">{event.time}</p>

          <!-- Small event poster thumbnail -->
          <a
            href={event.ticketUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 block w-32 group"
            aria-label={`View event details for ${event.title}`}
          >
            <div class="aspect-square bg-canvas border border-ink/15 overflow-hidden">
              <img
                src="/images/AscensionDay.jpg"
                alt={event.title}
                class="archival w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <p class="mt-2 text-[0.6rem] tracking-[0.25em] uppercase text-muted group-hover:text-gold transition-colors">
              View on Eventbrite →
            </p>
          </a>
        </div>
      </div>

      <!-- Body column -->
      <div class="lg:col-span-9 space-y-8">
        <header>
          <h3 class="font-display text-4xl md:text-5xl text-ink italic">
            {event.title}
          </h3>
          <p class="mt-3 text-ink/70 text-lg">{event.subtitle}</p>
        </header>

        <p class="text-ink/80 text-[1.05rem] leading-relaxed max-w-2xl">
          {event.description}
        </p>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-xl pt-6 border-t border-ink/10">
          <div>
            <dt class="eyebrow text-muted">Venue</dt>
            <dd class="mt-2 text-ink">{event.venue}</dd>
          </div>
          <div>
            <dt class="eyebrow text-muted">Address</dt>
            <dd class="mt-2 text-ink">{event.address}</dd>
          </div>
        </dl>

        <div class="pt-4">
          <a
            href={event.ticketUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn"
          >
            Reserve Tickets
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </article>
    )}

    <div class="reveal mt-20 pt-10 border-t border-ink/10 text-center">
      <a
        href="/past-events"
        class="inline-flex items-center gap-2 text-[0.7rem] tracking-[0.25em] uppercase text-muted hover:text-gold transition-colors group"
      >
        View past events
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</section>
